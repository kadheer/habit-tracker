# .gitattributes - steuert Zeilenenden pro Dateityp.
#
# Ich hab das angelegt, weil Git unter Windows staendig LF in CRLF
# umwandeln wollte. In Docker und CI (beides Linux) fuehrt das
# zu nervigen Fehlern wie "bad interpreter: /bin/bash^M".
#
# Faustregel: Textdateien sollen IMMER mit LF im Repository liegen.
# Git konvertiert dann beim Checkout auf Windows automatisch.

# Alle Textdateien normalisieren
* text=auto eol=lf

# Explizit fuer die wichtigsten Dateitypen
*.py    text eol=lf
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
Dockerfile    text eol=lf
Makefile      text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Binaerdateien nicht anfassen
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.db    binary
*.sqlite binary
